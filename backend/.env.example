# Copy to backend/.env, then: docker-compose up -d
# (also read by ./mvnw spring-boot:run thanks to spring-dotenv)

POSTGRES_DB_DEV=gymmanager_dev
POSTGRES_USER=gymuser
POSTGRES_PASSWORD=gympass

# Required, base64, at least 32 bytes. Dev-only value: replace it outside your machine. Generate with: openssl rand -base64 48
JWT_SECRET=AgKgEhwvCtpatWCKLd0gJ/5XE9HfVOCqaywEUBnLaaG1/b4KzTPWV8F/jYBanfw9

# Seeds demo accounts admin, instructor, staff (password 1234)
APP_SEED_DEMO_USERS=true
APP_URL=http://localhost:5173
